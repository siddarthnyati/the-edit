# Anthropic — editorial copy and QA
ANTHROPIC_API_KEY=

# Google Gemini — image generation (Nano Banana / 2.5 Flash Image)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — run state, archive, manifests (drip project, shared with styleMeUp)
SUPABASE_URL=https://bocvtwwmqphfnwmzdjcc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://bocvtwwmqphfnwmzdjcc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel admin app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Local styleMeUp clone for DESIGN.md / AGENTS.md context loading
STYLEMEUP_REPO_PATH=../styleMeUp

# Model routing — swap without code changes
MAGAZINE_RESEARCH_MODEL=claude-sonnet-4-6
MAGAZINE_EDITOR_MODEL=claude-sonnet-4-6
MAGAZINE_QA_MODEL=claude-sonnet-4-6
MAGAZINE_RANK_MODEL=claude-sonnet-4-6
MAGAZINE_PROMPT_MODEL=claude-sonnet-4-6

# Soft budget — orchestrator warns when exceeded but keeps running
MAGAZINE_BUDGET_USD=1.50

# Hard cap — orchestrator aborts the run if total cost crosses this.
# A full 7-slot / 4-variant image run is typically a little over $2 all-in.
MAGAZINE_HARD_CAP_USD=4.00

# Web search cap — when exceeded, research stops issuing new queries but
# salvages the sources already gathered. No point throwing away dollars
# already spent. Run aborts only if we hit the cap with zero sources.
MAGAZINE_WEB_SEARCH_CAP_USD=1.00

# Image variants per slot. 7 slots × 4 = 28 images per issue.
# Each costs $0.039 (Gemini 2.5 Flash Image).
MAGAZINE_VARIANTS_PER_SLOT=4

# Hard cap on image generation cost per run. Imagine executor aborts
# between slots if exceeded. Default $3 — covers ~76 images, well above
# the standard 28-image issue.
MAGAZINE_IMAGINE_CAP_USD=3.00

# Seed — optional trend hint for the research executor
MAGAZINE_SEED_TREND=
